    <string name="about_version">Version</string>
    <string name="about_desc">A local companion app for the HOOTOO HT-EP104. This build focuses on discovering what the headset really exposes.</string>
    <string name="about_principles">Principles</string>
    <string name="about_local">Everything stays on your phone: no account, no cloud, no telemetry, and no internet permission.</string>
    <string name="about_no_fabrication">Battery, charging and features are shown only when real evidence exists. Otherwise they are marked Unsupported or Not verified.</string>
    <string name="about_disconnect_vs_power">A Bluetooth disconnect is never presented as a physical power-off.</string>
    <string name="about_protocol_status">No vendor protocol for the HT-EP104 has been identified yet. Run the diagnostics and export a report to find out.</string>
